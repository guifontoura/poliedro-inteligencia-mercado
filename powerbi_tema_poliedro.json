{
  "name": "Poliedro Dark Navy",
  "dataColors": [
    "#D4AF37",
    "#3987e5",
    "#2BB673",
    "#EDA100",
    "#9085e9",
    "#d55181",
    "#5B6478",
    "#199e70"
  ],
  "background": "#141B2C",
  "foreground": "#F5F7FA",
  "firstLevelElements": "#F5F7FA",
  "secondLevelElements": "#C9CEDA",
  "thirdLevelElements": "#2A3550",
  "fourthLevelElements": "#8B93A7",
  "secondaryBackground": "#1B2438",
  "tableAccent": "#D4AF37",
  "good": "#2BB673",
  "neutral": "#EDA100",
  "bad": "#d55181",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 14,
      "color": "#F5F7FA"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#C9CEDA"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#D4AF37"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#141B2C" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1B2438" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#141B2C" } } }],
        "filterCard": [
          {
            "$id": "Applied",
            "foregroundColor": { "solid": { "color": "#F5F7FA" } },
            "backgroundColor": { "solid": { "color": "#1B2438" } },
            "inputBoxColor": { "solid": { "color": "#1B2438" } },
            "borderColor": { "solid": { "color": "#2A3550" } },
            "border": true
          },
          {
            "$id": "Available",
            "foregroundColor": { "solid": { "color": "#F5F7FA" } },
            "backgroundColor": { "solid": { "color": "#141B2C" } },
            "inputBoxColor": { "solid": { "color": "#1B2438" } },
            "borderColor": { "solid": { "color": "#2A3550" } },
            "border": true
          }
        ],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#F5F7FA" } },
            "background": { "solid": { "color": "#1B2438" } },
            "border": { "solid": { "color": "#1B2438" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#D4AF37" } }, "fontSize": 24 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#8B93A7" } }, "fontSize": 11 }]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1B2438" } } }],
        "items": [{ "background": { "solid": { "color": "#1B2438" } }, "fontColor": { "solid": { "color": "#F5F7FA" } } }],
        "numericInputStyle": [{ "background": { "solid": { "color": "#1B2438" } } }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1B2438" } } }],
        "items": [{ "background": { "solid": { "color": "#1B2438" } }, "fontColor": { "solid": { "color": "#F5F7FA" } } }],
        "numericInputStyle": [{ "background": { "solid": { "color": "#1B2438" } } }]
      }
    },
    "tableEx": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1B2438" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#F5F7FA" } }, "backColor": { "solid": { "color": "#2A3550" } } }],
        "values": [{ "fontColor": { "solid": { "color": "#F5F7FA" } } }]
      }
    }
  }
}
