{
  "name": "Poliedro Dark Gray",
  "dataColors": [
    "#D4AF37",
    "#E2571F",
    "#2E86AB",
    "#F0C468",
    "#C74B32",
    "#5AA9C4",
    "#B8860B",
    "#F2894E",
    "#1F6690",
    "#EAD08A"
  ],
  "foreground": "#F0F0F0",
  "foregroundNeutralSecondary": "#B5B5B5",
  "foregroundNeutralTertiary": "#8A8A8A",
  "background": "#1C1C1E",
  "backgroundLight": "#262626",
  "backgroundNeutral": "#333333",
  "tableAccent": "#D4AF37",
  "maximum": "#2E86AB",
  "center": "#D4AF37",
  "minimum": "#B5B5B5",
  "hyperlink": "#5AA9C4",
  "visitedHyperlink": "#2E86AB",
  "textClasses": {
    "callout": { "fontFace": "Arial", "color": "#F0F0F0" },
    "title": { "fontFace": "Arial", "color": "#F0F0F0" },
    "header": { "fontFace": "Arial", "color": "#F0F0F0" },
    "label": { "fontFace": "Arial", "color": "#F0F0F0" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1C1C1E" } } }],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#F0F0F0" } },
            "border": { "solid": { "color": "#1C1C1E" } },
            "background": { "solid": { "color": "#1C1C1E" } }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#1C1C1E" } },
            "foregroundColor": { "solid": { "color": "#F0F0F0" } },
            "transparency": 0,
            "border": true,
            "borderColor": { "solid": { "color": "#4A4A4A" } }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "transparency": 0,
            "foregroundColor": { "solid": { "color": "#F0F0F0" } },
            "backgroundColor": { "solid": { "color": "#333333" } },
            "inputBoxColor": { "solid": { "color": "#333333" } },
            "borderColor": { "solid": { "color": "#4A4A4A" } },
            "border": true
          },
          {
            "$id": "Available",
            "transparency": 0,
            "foregroundColor": { "solid": { "color": "#F0F0F0" } },
            "backgroundColor": { "solid": { "color": "#1C1C1E" } },
            "inputBoxColor": { "solid": { "color": "#1C1C1E" } },
            "borderColor": { "solid": { "color": "#4A4A4A" } },
            "border": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#262626" } } }],
        "labels": [{ "color": { "solid": { "color": "#F0F0F0" } } }],
        "categoryLabels": [{ "color": { "solid": { "color": "#B5B5B5" } } }]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#262626" } } }]
      }
    },
    "tableEx": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#262626" } } }],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#F0F0F0" } },
            "backColor": { "solid": { "color": "#333333" } }
          }
        ],
        "values": [{ "fontColor": { "solid": { "color": "#F0F0F0" } } }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "background": { "solid": { "color": "#262626" } } }],
        "numericInputStyle": [{ "background": { "solid": { "color": "#262626" } } }]
      }
    },
    "columnChart": {
      "*": { "background": [{ "color": { "solid": { "color": "#262626" } } }] }
    },
    "clusteredColumnChart": {
      "*": { "background": [{ "color": { "solid": { "color": "#262626" } } }] }
    },
    "donutChart": {
      "*": { "background": [{ "color": { "solid": { "color": "#262626" } } }] }
    },
    "funnel": {
      "*": { "background": [{ "color": { "solid": { "color": "#262626" } } }] }
    },
    "keyDriversVisual": {
      "*": {
        "keyInfluencersVisual": [
          { "canvasColor": { "solid": { "color": "#262626" } } }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#1C1C1E" } } }],
        "background": [{ "transparency": 0 }]
      }
    }
  }
}
