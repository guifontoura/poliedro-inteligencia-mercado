{
  "name": "Poliedro Dark Navy",
  "dataColors": [
    "#D4AF37",
    "#E2571F",
    "#2E86AB",
    "#C9A227",
    "#C74B32",
    "#1F6690",
    "#E8C468",
    "#5AA9C4"
  ],
  "background": "#141B2C",
  "foreground": "#F5F7FA",
  "tableAccent": "#D4AF37",
  "good": "#6FCF97",
  "bad": "#E2571F",
  "neutral": "#9AA5B8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#141B2C" } },
            "transparency": 0
          }
        ],
        "border": [
          { "show": false }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E2740" } },
            "transparency": 0
          }
        ],
        "labels": [
          { "color": { "solid": { "color": "#F5F7FA" } }, "fontSize": 28 }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#9AA5B8" } } }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ]
      }
    },
    "tableEx": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#F5F7FA" } },
            "backColor": { "solid": { "color": "#262F4A" } }
          }
        ],
        "values": [
          { "fontColor": { "solid": { "color": "#F5F7FA" } } }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ]
      }
    },
    "columnChart": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ]
      }
    },
    "donutChart": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ]
      }
    },
    "funnel": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#1E2740" } }, "transparency": 0 }
        ]
      }
    }
  }
}
